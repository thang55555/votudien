<script>
document.addEventListener("DOMContentLoaded", function () {
  const currentPath = window.location.pathname;
  const menuItems = document.querySelectorAll("ul.header-nav li");

  menuItems.forEach(function (li) {
    const link = li.querySelector("a");
    if (!link) return;

    const linkPath = new URL(link.href).pathname;

    const isExactMatch = currentPath === linkPath;
    const isParentMatch = currentPath.startsWith(linkPath + "/");

    const isDropdownItem = li.closest(".nav-dropdown");

    // Nếu là mục con trong dropdown: KHÔNG được active
    if (isDropdownItem) {
      li.classList.remove("active");
      return;
    }

    // Nếu là mục thường (Trang chủ, Giới thiệu, Sản phẩm)
    if (isExactMatch && !isDropdownItem) {
      li.classList.add("active");
    }

    // Nếu là mục cha (có dropdown) và URL con trùng
    if (li.classList.contains("menu-item-has-children") && (isExactMatch || isParentMatch)) {
      li.classList.add("active");
    }
  });
});
</script>





