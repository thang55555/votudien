                                                                currency: "VND" , minimumFractionDigits: 0,
                                                                }).format(item.price*item.qty)%><span
                                                                    class="woocommerce-Price-currencySymbol"></span>
                                                        </bdi></span>
                                                </td>
                                            </tr>
