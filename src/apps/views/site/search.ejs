                    <div class="page-title-inner flex-row  medium-flex-wrap container">
                        <div class="flex-col flex-grow medium-text-center">
                            <h1 class="shop-page-title is-xlarge">Tìm kiếm</h1>
                            <div class="is-smaller">
                                <nav class="woocommerce-breadcrumb breadcrumbs"><a href="/">Trang chủ</a> 
                                     <span class="divider">/</span> <a href="/san-pham">Sản phẩm</a>
                                     <span class="divider">&#47;</span> Tìm kiếm: <%=keyword%></nav>
                            </div>
                        </div><!-- .flex-left -->

                        <div class="flex-col medium-text-center">


                            <p class="woocommerce-result-count hide-for-medium">
                                Xem tất cả <%=totalRows%> kết quả</p>
                            <form class="woocommerce-ordering" method="get" action="/search"   enctype="multipart/form-data">
                                <select name="orderby" class="orderby" id="orderby-select" >
                                            <option value="" >--Tùy chọn bộ lọc--</option>
                                    <option value="popularity" selected='selected'>Thứ tự theo mức độ phổ biến</option>
                                    <option value="date">Thứ tự theo sản phẩm mới</option>
                                    <option value="price">Thứ tự giá tăng dần: thấp đến cao</option>
                                    <option value="price-desc">Thứ tự theo giá giảm dần: cao xuống thấp</option>
                                </select>
                                <input type="hidden" name="paged" value="1" />
                                <input type="hidden" name="s" value="<%=keyword%>" />
                            </form>
<script>
const selectElement = document.getElementById("orderby-select");

// Khi người dùng thay đổi lựa chọn
selectElement.addEventListener("change", function () {
    const selectedValue = this.value;
    // Lưu vào localStorage
    localStorage.setItem("selectedOrderBy", selectedValue);
});

// Khi trang được tải lại
window.addEventListener("DOMContentLoaded", function () {
    const savedValue = localStorage.getItem("selectedOrderBy");
    const referrer = document.referrer;

    if (referrer) {
        const referrerPath = new URL(referrer).pathname;

        // So sánh trang trước là /san-pham hoặc tùy chỉnh path của bạn
        if (referrerPath === "/search" && savedValue) {
            selectElement.value = savedValue;

            Array.from(selectElement.options).forEach(option => {
                option.removeAttribute("selected");
                if (option.value === savedValue) {
                    option.setAttribute("selected", "selected");
                }
            });
        } else {
            localStorage.removeItem("selectedOrderBy");
            selectElement.value = "";
        }
    } else {
        // Trường hợp người dùng truy cập trực tiếp không có referrer
        localStorage.removeItem("selectedOrderBy");
        selectElement.value = "";
    }
});
</script>




