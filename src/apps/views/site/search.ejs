


<%- include("./layouts/head.ejs")%>
    <title>Sản phẩm</title>
    <meta name="description" content="Sản phẩm" />
    <meta name="keywords" content="Sản phẩm" />
    <meta property="og:title" content="Sản phẩm" />
    <meta property="og:description" content="Sản phẩm" />
    <meta property="og:keywords" content="Sản phẩm" />
   

</head>

    <body
        class="archive tax-product_cat term-bo-dem term-203 theme-mtw-haiau woocommerce woocommerce-page woocommerce-no-js">
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WPQ49BL" height="0" width="0"
                style="display:none;visibility:hidden"></iframe></noscript>
        <%- include("./layouts/menu.ejs")%>
            <link data-optimized="1" href="wp-content/litespeed/css/849f26c3d813910c18884d45e12ec87e3114.css?ver=dd6ca"
                type="text/css" rel="stylesheet" />
            <div class="container mainpage">
                <div class="breadcrumb"></div>
                <div class="row ">
                    <div class="col-xs-12 col-sm-12 col-md-12 ">
                        <nav class="woocommerce-breadcrumb breadcrumbs"><a href="/">Trang chủ</a> <span
                                class="divider">/</span> <a href="/san-pham">Sản phẩm /</a> <span >Tìm kiếm: <%=keyword%> có <%=product.length%> kết quả.</span>
                         
                        </nav>
                    </div>
                </div>
            </div>

              <div class="container mainpage white">
        <div class="row" id="homeproduct">

          <div id="tw-recent-posts-14" class="widget tw-recent-posts">

            <div class="cont_home">
              <%for(item of product){%>
                <div class="col-xs-6 col-md-2 col-sm-3 motsanpham">
                  <a href="/san-pham/<%=item._id%>" title="<%=item.name%>"><img width="400" height="400"
                      src="./images/update/<%=item.images[0].name%>"
                      class="attachment-thumb-home-product size-thumb-home-product wp-post-image"
                      alt="<%=item.images[0].name%>"></a>
                  <div class="caption">
                    <h3><a href="/san-pham/<%=item._id%>" title="<%=item.name%>">
                        <%=item.name%>
                      </a></h3>

                    <div class="post-price">
                      <% if (item.pricesale==0) { %>
                        <div class="price-contact">
                          <span style="color: #333;">Giá:</span>  <span style=" color: #e60000;
  font-weight: bold">LIÊN HỆ</span> 
                        </div>
                        <% } else if (item.pricesale && item.pricesale < item.price) { %>
                          <div class="price-old">
                            <%= new Intl.NumberFormat("vi-VN", { style: "currency" , currency: "VND" ,
                              minimumFractionDigits: 0, }).format(item.price) %>
                          </div>
                          <div class="price-sale">
                            <%= new Intl.NumberFormat("vi-VN", { style: "currency" , currency: "VND" ,
                              minimumFractionDigits: 0, }).format(item.pricesale) %>
                          </div>
                          <div class="salepercent">
                            -<%= Math.round((1 - item.pricesale / item.price) * 100) %>%
                          </div>
                          <% } else { %>
                            <div class="price-normal">
                              <%= new Intl.NumberFormat("vi-VN", { style: "currency" , currency: "VND" ,
                                minimumFractionDigits: 0, }).format(item.price) %>
                            </div>
                            <% } %>
                    </div>
                  </div>
                </div>
                <% } %>
            </div>
            <span class="paging">
              <div class='wp-pagenavi' role='navigation'>

                <% if (hasPrev) { %>
                  <a class="page larger" href="/danh-muc/<%= products.slug %>?page=<%= prev %>">&laquo;</a>
                  <% } %>

                    <% for (let i of pages) { %>
                      <% if (i===page) { %>
                        <span aria-current='page' class='current'>
                          <%= i %>
                        </span>
                        <% } else if (i==="..." ) { %>
                          <span class="page larger">
                            <%= i %>
                          </span>
                          <% } else { %>
                            <a class="page larger" href="/danh-muc/<%= products.slug %>?page=<%= i %>">
                              <%= i %>
                            </a>
                            <% } %>
                              <% } %>

                                <% if (hasNext) { %>
                                  <a class="page larger"
                                    href="/danh-muc/<%= products.slug %>?page=<%= next %>">&raquo;</a>
                                  <% } %>

              </div>
            </span>
          </div>
          <style>
            .post-price {
              display: flex;
              align-items: center;
              gap: 8px;
              margin-top: 5px;
            }

            .price-old {
              color: #999;
              text-decoration: line-through;
              font-size: 14px;
            }

            .price-sale {
              color: #e53935;
              font-weight: bold;
              font-size: 18px;
            }

            .price-normal {
              color: #e53935;
              font-weight: bold;
              font-size: 18px;
            }

            .salepercent {
              background: #ff5722;
              color: #fff;
              font-size: 12px;
              font-weight: bold;
              padding: 2px 6px;
              border-radius: 4px;
            }
          </style>

        </div>
      </div>

            <%- include("./layouts/footer.ejs")%>