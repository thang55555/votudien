<%- include("../layout/head", {title: "Product" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>


            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/san-pham"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li>Danh sách sản phẩm</li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Danh sách view sản phẩm</h1>
                  

                    </div>
                </div><!--/.row-->
                     <form class="woocommerce-ordering" method="get" action="/admin/view"   enctype="multipart/form-data">
                                <select name="orderby" class="orderby" id="orderby-select">
                                    <option value="" >--Tùy chọn bộ lọc--</option>
                                    <option value="date" >Ngày xem gần nhất</option>
                                    <option value="view">Số view nhiều nhất</option>
                                </select>
                                <input type="hidden" name="paged" value="<%=page%>" />
                            </form>
          

<script>
    document.getElementById('orderby-select').addEventListener('change', function() {
        this.form.submit();
    });
</script>

                            <script>
                                const selectElement = document.getElementById("orderby-select");

                                // Khi người dùng thay đổi lựa chọn
                                selectElement.addEventListener("change", function () {
                                    const selectedValue = this.value;
                                    // Lưu vào localStorage
                                    localStorage.setItem("selectedOrderBy", selectedValue);
                                });

                                // Khi trang được tải lại
                                window.addEventListener("DOMContentLoaded", function () {
                                    const savedValue = localStorage.getItem("selectedOrderBy");
                                    const referrer = document.referrer;

                                    if (referrer) {
                                        const referrerPath = new URL(referrer).pathname;

                                        // So sánh trang trước là /san-pham hoặc tùy chỉnh path của bạn
                                        if (referrerPath === "/admin/view" && savedValue) {
                                            selectElement.value = savedValue;

                                            Array.from(selectElement.options).forEach(option => {
                                                option.removeAttribute("selected");
                                                if (option.value === savedValue) {
                                                    option.setAttribute("selected", "selected");
                                                }
                                            });
                                        } else {
                                            localStorage.removeItem("selectedOrderBy");
                                            selectElement.value = "";
                                        }
                                    } else {
                                        // Trường hợp người dùng truy cập trực tiếp không có referrer
                                        localStorage.removeItem("selectedOrderBy");
                                        selectElement.value = "";
                                    }
                                });
                            </script>

                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <table data-toolbar="#toolbar" data-toggle="table">

                                    <thead>
                                        <tr>
                                            <th data-field="id" data-sortable="true">ID</th>
                                            <th data-field="name" data-sortable="true">Tên sản phẩm</th>
                                            <th>Ảnh SP</th>
                                            <th>Số view</th>
                                            <th>Lần xem gần nhất</th>
                                            <th>Link bài viết</th>
                                            <th>Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for(item of product){%>
                                            <tr>
                                                <td>  <%=stt++%>  </td>
                                                <td style="width: 50px;"> <%=item.name%> </td>
                                                <td>  <img height="150px" width="150px"
                                                        src="../site/images/update/<%=item.images[0].name%>" /> </td>
                                                <td> <%=item.view%> </td>
                                                <td> <%
  const date = new Date(item.updatedAt);
  const formattedDate = date.toLocaleString('vi-VN', {
    hour: '2-digit',
    minute: '2-digit',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour12: false,
    timeZone: 'Asia/Ho_Chi_Minh'
  });
%>

<p>Cập nhật lúc: <%= formattedDate %></p>

 </td>
                                                <td> <a href="/san-pham/<%=item._id%>"> link bài viết</a> </td>
                                                <td class="form-group">
                                                    <a href="/admin/edit-san-pham/<%=item._id%>?page=<%=page%>"
                                                        class="btn btn-primary"><i
                                                            class="glyphicon glyphicon-pencil"></i></a>
                                                    <a onclick="clickDelete('<%=item._id%>')"
                                                        class="btn btn-danger"><i
                                                            class="glyphicon glyphicon-remove"></i></a>
                                                </td>
                                            </tr>
                                            <% }%>
                                    </tbody>
                                </table>
                            </div>
                            <div class="panel-footer">
                                <nav aria-label="Page navigation example">
                                    <ul class="pagination">
                                        <% if(hasPrev){%>
                                            <li class="page-item"><a class="page-link"
                                                    href="/admin/view?page=<%=prev%><%= orderBy ? '&orderby=' + orderBy : '' %>">&laquo;</a></li>
                                            <% }%>
                                                <% for(i of pages){%>
                                                    <% if(i==="..." ){%>
                                                        <li class="page-item <%= page === i ? 'active' : '' %>"><span
                                                                class="page-link" <%=i%>></span>
                                                        </li>
                                                        <% }else{%>
                                                            <li class="page-item <%= page === i ? 'active' : '' %>"><a
                                                                    class="page-link"
                                                                    href="/admin/view?page=<%=i%><%= orderBy ? '&orderby=' + orderBy : '' %>">
                                                                    <%=i%>
                                                                </a></li>
                                                            <%}%>
                                                                <% }%>
                                                                    <% if(hasNext){%>
                                                                        <li class="page-item"><a class="page-link"
                                                                                href="/admin/view?page=<%=next%><%= orderBy ? '&orderby=' + orderBy : '' %>">&raquo;</a>
                                                                        </li>
                                                                        <% }%>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div><!--/.row-->
            </div> <!--/.main-->

            <script src="js/jquery-1.11.1.min.js"></script>
            <script src="js/bootstrap.min.js"></script>
            <script src="js/bootstrap-table.js"></script>
            <script>
                function handleConfirm(id) {
                    const isConfirm = confirm(`Bạn có chắc chắn xóa không?`)
                    const link = () => window.location.href = `/admin/delete-san-pham/${id}?page=<%=page%>`
                    return isConfirm ? link() : false
                }
                const clickDelete = (id) => handleConfirm(id)
            </script>


            <%- include("../layout/footer")%>