<%- include("../layout/head", {title: "Edit Product" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>

            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="#"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li><a href="/admin/san-pham">Quản lý sản phẩm</a></li>
                        <li>
                            <%=product.name%>
                        </li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Sản phẩm: <%=product.name%>
                        </h1>
                    </div>
                </div><!--/.row-->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="col-md-6">
                                    <form action="/admin/update-san-pham/<%= product.id %>?page=<%= page %>" role="form" method="post"
                                        enctype="multipart/form-data">
                                        <div class="form-group">
                                            <label>Tên sản phẩm:</label>
                                            <input type="text" name="name" required class="form-control"
                                                value="<%=product.name%>" placeholder="">
                                        </div>
                                            <div class="form-group">
                                            <label>Mã sản phẩm:</label>
                                            <input required name="masanpham" value="<%=product.masanpham%>" class="form-control" placeholder="">
                                        </div>
                                         <div class="form-group">
                                            <label>Thứ tự hiển thị:</label>
                                            <input required name="thutuhienthi"  value="<%=product.thutuhienthi%>" class="form-control" type="number" placeholder="">
                                        </div>
                                        <div class="form-group">
                                            <label>Thẻ title:</label>
                                            <input required name="title" value="<%=product.title%>" class="form-control"
                                                placeholder="">
                                        </div>
                                        <div class="form-group">
                                            <label>Thẻ description:</label>
                                            <input required name="description" value="<%=product.description%>"
                                                class="form-control" placeholder="">
                                        </div>
                                        <div class="form-group">
                                            <label>Thẻ keywords:</label>
                                            <input required name="keywords" value="<%=product.keywords%>"
                                                class="form-control" placeholder="">
                                        </div>
                                        <div class="form-group">
                                            <label>Giá gốc sản phẩm</label>
                                            <input type="number" name="price" required value="<%=product.price%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Giá sale sản phẩm</label>
                                            <input type="number" name="pricesale" required
                                                value="<%=product.pricesale%>" class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Ảnh sản phẩm</label>

                                            <input name="images" type="file" multiple />
                                            <br>

                                        </div>
                                         <div class="form-group">
                                            <label>Chính Hãng</label>
                                            <select name="hang_id" class="form-control" style="height: auto;">
                                                <% for(category of hang){%>
                                                    <option value=<%=category._id %>
                                                           <%= product.hang_id.includes(category._id.toString()) ? "selected" : "" %>>
                                                           <%=category.name%>
                                                    </option>
                                                    <%}%>
                                                    <option value="68d7add80f2de0ba7828aeda"
    <%= product.hang_id.map(id => id.toString())
        .includes("68d7add80f2de0ba7828aeda") ? "selected" : "" %>>
    Hãng khác
</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label>Danh mục</label>
                                         <select name="danhmuc2_id[]" class="form-control" multiple style="height: 300px;">
  <% for (const category of danhmuc) { %>
    <option value="<%= category._id %>" 
      <%= product.danhmuc2_id.includes(category._id.toString()) ? "selected" : "" %>>
      <%= category.name %>
    </option>
  <% } %>
</select>

                                        </div>

                                </div>
                                <div class="col-md-6">


                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                <input <%=product.trangthai==1 && "checked" %> name="trangthai"
                                                type="checkbox" value="on">Đăng ngay
                                            </label>
                                        </div>
                                    </div>


                                    <div class="form-group">

                                        <div class="checkbox">
                                            <label>
                                                <input <%=product.spmoi==1 && "checked" %> name="spmoi" type="checkbox"
                                                value=on>Sản phẩm mới
                                            </label>
                                        </div>
                                        <div class="checkbox">
                                            <label>
                                                <input <%=product.spnoibat==1 && "checked" %> name="spnoibat"
                                                type="checkbox" value=on>sản phẩm nổi bật
                                            </label>
                                        </div>
                                        <div class="checkbox">
                                            <label>
                                                <input <%=product.spcaocap==1 && "checked" %> name="spcaocap"
                                                type="checkbox" value=on>sản phẩm QC giỏ hàng
                                            </label>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Mô tả sản phẩm</label>
                                        <textarea id="description" name="content" required class="form-control"
                                            rows="3"><%=product.content%></textarea>
                                        <script>
                                            CKEDITOR.replace('description', {
                                                extraPlugins: 'filebrowser',
                                                filebrowserBrowseUrl: '/list',//upload location
                                                filebrowserUploadMethod: 'form',
                                                filebrowserUploadUrl: '/upload'//route
                                            });
                                        </script>
                                    </div>
                                    <div class="form-group">
                                        <label>Mô tả ngắn</label>
                                        <textarea id="description22" name="content2" required class="form-control"
                                            rows="3"><%=product.content2%></textarea>
                                        <script>
                                            CKEDITOR.replace('description22', {
                                                extraPlugins: 'filebrowser',
                                                filebrowserBrowseUrl: '/list',//upload location
                                                filebrowserUploadMethod: 'form',
                                                filebrowserUploadUrl: '/upload'//route
                                            });
                                        </script>
                                    </div>
                                    <button type="submit" name="sbm" class="btn btn-primary">Cập nhật</button>
                                    <button type="reset" class="btn btn-default">Làm mới</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div><!-- /.col-->
                </div><!-- /.row -->

            </div> <!--/.main-->
            	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>	
            <%- include("../layout/footer")%>