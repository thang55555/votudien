<%- include("../layout/head", {title: "Product" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>


            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="#"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li class="active">Danh sách mã voucher</li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Danh sách mã voucher</h1>
                    </div>
                </div><!--/.row-->
                <div id="toolbar" class="btn-group">
                    <a href="/admin/addvoucher" class="btn btn-success">
                        <i class="glyphicon glyphicon-plus"></i> Thêm voucher
                    </a>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <table data-toolbar="#toolbar" data-toggle="table">

                                    <thead>
                                        <tr>
                                            <th data-field="id" data-sortable="true">ID</th>
                                            <th data-field="name" data-sortable="true">Mã Voucher</th>
                                            <th data-field="price" data-sortable="true">Số Tiền</th>
                                            <th data-field="pricesale" data-sortable="true">Trạng thái</th>
                                            <th>Áp dụng với hóa đơn</th>
                                            <th>Xóa Voucher</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                                        <% for(item of items){%>
                                            <tr>
                                                <td>1</td>
                                                <td><%=item.makm%></td>
                                                <td><%= new Intl.NumberFormat("vi-VN", { style: "currency" ,
                                                    currency: "VND" , minimumFractionDigits: 0,
                                                    }).format(item.sotien) %></td>
                                                <td><%=item.trangthai? "Đang hoạt động" : "Hết hạn"%></td>
                                                <td><%= new Intl.NumberFormat("vi-VN", { style: "currency" ,
                                                    currency: "VND" , minimumFractionDigits: 0,
                                                    }).format(item.dieukien) %></td>
                                                <td> <a href="/admin/deleteVoucher/<%=item._id%>"
                                                    class="btn btn-danger"><i
                                                        class="glyphicon glyphicon-remove"></i></a></td>
                                                </tr>
                                                <%}%>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div><!--/.row-->
            </div> <!--/.main-->

            <script src="js/jquery-1.11.1.min.js"></script>
            <script src="js/bootstrap.min.js"></script>
            <script src="js/bootstrap-table.js"></script>

            <%- include("../layout/footer")%>