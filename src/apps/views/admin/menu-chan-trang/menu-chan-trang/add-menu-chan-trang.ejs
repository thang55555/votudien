<%- include("../../layout/head", {title: "Add Product" })%>
    <%- include("../../layout/header")%>
        <%- include("../../layout/siderbar")%>

            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li><a href="/admin/menu-chan-trang/<%=idchantrang%>">Quản lý menu chân trang</a></li>
                        <li>Thêm menu chân trang</li>
                    </ol>
                </div><!--/.row-->

                
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="col-md-6">
                                    <form action="/admin/upload-menu-chan-trang/<%=idchantrang%>" role="form" method="post"
                                        enctype="multipart/form-data">
                                        <div class="form-group">
                                            <label>Tên menu chân trang:</label>
                                            <input required name="name" class="form-control" placeholder="Tên menu...">
                                        </div>
<div class="form-group">
    <label>Thẻ title <span id="label_title"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)" 
           name="title" type="text" class="form-control" placeholder="Title">
    
    <div class="progress-container">
        <div id="bar_title" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta description <span id="label_meta"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)" 
           name="description" type="text" class="form-control" placeholder="Meta description...">
    
    <div class="progress-container">
        <div id="bar_meta" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta keywords <span id="label_keywords"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)" 
           name="keywords" type="text" class="form-control" placeholder="Meta keywords...">
    
    <div class="progress-container">
        <div id="bar_keywords" class="progress-bar"></div>
    </div>
</div>

                                </div>
                                <div class="col-md-6">


                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                <input name="trangthai" type="checkbox" value="on">Đăng ngay
                                            </label>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label>Mô tả menu</label>
                                        <textarea id="description" required name="content" class="form-control"
                                            rows="3"></textarea>
                                        <script>
                                            CKEDITOR.replace('description', {
                                                extraPlugins: 'filebrowser',
                                                filebrowserBrowseUrl: '/list',//upload location
                                                filebrowserUploadMethod: 'form',
                                                filebrowserUploadUrl: '/upload'//route
                                            });
                                        </script>
                                    </div>
                              
                                    <input type="hidden" name="idchantrang" value="<%=idchantrang%>">
                                    <button name="sbm" type="submit" class="btn btn-success">Thêm mới</button>
                                    <button type="reset" class="btn btn-default">Làm mới</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div><!-- /.col-->
                </div><!-- /.row -->

            </div> <!--/.main-->

            	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>	
    

            <%- include("../../layout/footer")%>