<%- include("../layout/head", {title: "Product" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>


            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li>Danh sách tin tức</li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Danh sách tin tức</h1>
                    </div>
                </div><!--/.row-->
                <div id="toolbar" class="btn-group">
                    <a href="/admin/add-tin-tuc" class="btn btn-success">
                        <i class="glyphicon glyphicon-plus"></i> Thêm tin tức
                    </a>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <table data-toolbar="#toolbar" data-toggle="table">

                                    <thead>
                                        <tr>
                                            <th data-field="id" data-sortable="true">ID</th>
                                            
                                            <th>Hành động</th>
                                            <th data-field="name" data-sortable="true">Tên bài viết </th>
                                            <th>Ảnh chính</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for(product of products){%>
                                            <tr>
                                                <td>
                                                    <%=stt++%>
                                                </td>
                                                <td class="form-group">

                                                                 	<a href="/admin/edit-tin-tuc/<%=product._id%>?page=<%=page%>"><i
															class="fa-solid fa-pen-to-square"></i></a>
													<a onclick="clickDelete('<%=product._id%>')"><i
															class="fa-solid fa-trash"
															style="color: rgb(48, 165, 255);"></i> </a>
													<a href="/admin/view/tin-tuc/<%=product._id%>"
														target="_blank">
														<i class="fa-solid fa-eye"></i> </a>
                                                </td>
                                                <td style="width: 50px;">

                                                    <%=product.name%>
                                                </td>
                                                <td>
                                                    <img height="150px" width="150px"
                                                        src="../site/images/update/<%=product.image%>" />

                                                </td>
                                                <td><span
                                                        class="label label-<%=product.trangthai? 'success': 'danger'%>">
                                                        <%=product.trangthai? "Đã đăng" : "Nháp" %>
                                                    </span></td>
                                                
                                            </tr>
                                            <% }%>
                                    </tbody>
                                </table>
                            </div>
                            <div class="panel-footer">
                                <nav aria-label="Page navigation example">
                                    <ul class="pagination">
                                        <% if(hasPrev){%>
                                            <li class="page-item"><a class="page-link"
                                                    href="/admin/tin-tuc?page=<%=prev%>">&laquo;</a></li>
                                            <% }%>
                                                <% for(i of pages){%>
                                                    <% if(i==="..." ){%>
                                                        <li class="page-item <%= page === i ? 'active' : '' %>"><span class="page-link" <%=i%>></span>
                                                        </li>
                                                        <% }else{%>
                                                            <li class="page-item <%= page === i ? 'active' : '' %>"><a class="page-link"
                                                                    href="/admin/tin-tuc?page=<%=i%>">
                                                                    <%=i%>
                                                                </a></li>
                                                            <%}%>
                                                                <% }%>
                                                                    <% if(hasNext){%>
                                                                        <li class="page-item"><a class="page-link"
                                                                                href="/admin/tin-tuc?page=<%=next%>">&raquo;</a>
                                                                        </li>
                                                                        <% }%>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div><!--/.row-->
            </div> <!--/.main-->

            <script src="js/jquery-1.11.1.min.js"></script>
            <script src="js/bootstrap.min.js"></script>
            <script src="js/bootstrap-table.js"></script>
            <script>
                function handleConfirm(id) {
                    const isConfirm = confirm(`Bạn có chắc chắn xóa không?`)
                    const link = () => window.location.href = `/admin/delete-tin-tuc/${id}?page=<%=page%>`
                    return isConfirm ? link() : false
                }
                const clickDelete = (id) => handleConfirm(id)
            </script>


            <%- include("../layout/footer")%>