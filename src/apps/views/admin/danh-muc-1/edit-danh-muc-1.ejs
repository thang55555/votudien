<%- include("../layout/head", {title: "Edit caterogy" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>

            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li><a href="/admin/danh-muc">Quản lý danh mục</a></li>
                        <li >Danh mục 1</li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Danh mục:Danh mục 1</h1>
                    </div>
                </div><!--/.row-->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="col-md-8">
                                    <div class="<%=data.error? " alert alert-danger" : "" %>" ><%=data.error%>
                                    </div>
                                    <form role="form" method="post" action="/admin/update-danh-muc/<%=product._id%>">
                                        <div class="form-group">
                                            <label>Tên danh mục:</label>
                                            <input type="text" name="name" required value="<%=product.name%>"
                                                class="form-control" placeholder="Tên danh mục...">
                                        </div>
    

<div class="form-group">
    <label>Thẻ title <span id="label_title"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)" 
           name="title" value="<%=product.title%>" type="text" class="form-control" placeholder="Title">
    
    <div class="progress-container">
        <div id="bar_title" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta description <span id="label_meta"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)" 
           name="description" value="<%=product.description%>" type="text" class="form-control" placeholder="Meta description...">
    
    <div class="progress-container">
        <div id="bar_meta" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta keywords <span id="label_keywords"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)" 
           name="keywords" value="<%=product.keywords%>" type="text" class="form-control" placeholder="Meta keywords...">
    
    <div class="progress-container">
        <div id="bar_keywords" class="progress-bar"></div>
    </div>
</div>




                                        <button type="submit" name="sbm" class="btn btn-primary">Cập nhật</button>
                                        <button type="reset" class="btn btn-default">Làm mới</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div><!-- /.col-->
                </div> <!--/.main-->
	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>	

                <%- include("../layout/footer")%>